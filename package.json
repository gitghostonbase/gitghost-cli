{
  "name": "@gitghost/cli",
  "version": "0.1.3",
  "description": "ship code, leave no trace. anonymous git commits via linkable ring signatures.",
  "type": "module",
  "bin": {
    "gitghost": "dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "git",
    "ring-signature",
    "lsag",
    "anonymous",
    "privacy",
    "secp256k1",
    "cypherpunk",
    "gitghost"
  ],
  "license": "MIT",
  "homepage": "https://gitghost.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitghostonbase/gitghost-cli.git"
  },
  "bugs": {
    "url": "https://github.com/gitghostonbase/gitghost-cli/issues"
  },
  "author": "gitghost",
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
